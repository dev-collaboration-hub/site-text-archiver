{
  "manifest_version": 3,
  "name": "Site Text Archiver",
  "version": "0.5.0",
  "description": "Local-first documentation archiver with bounded crawling and scratch-built semantic content extraction.",
  "permissions": ["storage", "activeTab", "alarms"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Site Text Archiver",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  }
}
