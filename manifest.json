{
  "manifest_version": 3,
  "name": "Site Text Archiver",
  "version": "0.1.0",
  "description": "Local-first documentation archiver foundation.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_title": "Site Text Archiver",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  }
}
